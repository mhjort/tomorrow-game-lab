{
  "name": "tomorrow-game-lab",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "validate": "node lab/validate-skills.mjs",
    "test": "node lab/validate-skills.mjs && node --test lab/test/*.test.mjs",
    "test:golden": "pnpm release:minigolf && node skills/game-judge/scripts/playtest.mjs --project examples/minigolf",
    "keyart": "skills/blender-assets/scripts/run_blender.sh lab/fixtures/keyart/build_keyart.py",
    "eval": "node lab/eval/run-eval.mjs",
    "release:minigolf": "pnpm --filter minigolf run release",
    "release:snowplough": "pnpm --filter snowplough run release",
    "site": "pnpm release:minigolf && pnpm release:snowplough && node lab/build-site.mjs"
  },
  "packageManager": "pnpm@12.16.1"
}

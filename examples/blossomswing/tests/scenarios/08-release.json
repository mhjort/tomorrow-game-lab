{
  "name": "release",
  "description": "letting go on the way up (~20°) flies far; letting go near the top is a short drop; a real Space press lets go; a backward let-go keeps the best distance",
  "steps": [
    { "step": 2 },
    { "input": { "type": "start" } },
    { "input": { "type": "debug", "rows": 5, "theta": -44, "omega": 0 } },
    { "step": 30 },
    { "script": "bots/swinger.ts", "args": { "stop": "landed", "max": 600, "release": 20 } },
    { "assert": "state.leap.distance > 6", "label": "20° on the upswing flies 6 m+" },
    { "eval": "window.__game.getState().leap.distance" },
    { "step": 60 },
    { "input": { "type": "kick" } },
    { "step": 2 },
    { "input": { "type": "debug", "theta": -44, "omega": 0 } },
    { "step": 30 },
    { "script": "bots/swinger.ts", "args": { "stop": "landed", "max": 600, "release": 40 } },
    { "assert": "state.leap.distance < state.leap.best - 1.5", "label": "letting go near the top (40°) is clearly shorter" },
    { "step": 60 },
    { "input": { "type": "kick" } },
    { "step": 2 },
    { "input": { "type": "debug", "theta": -22, "omega": 0 } },
    { "step": 50 },
    { "assert": "state.swing.omega > 0 && state.swing.deg > 5 && state.swing.deg < 20", "label": "on the upswing" },
    { "key": "Space", "steps": 2 },
    { "assert": "state.phase === 'flight'", "label": "a real Space press lets go" },
    { "step": 240 },
    { "assert": "state.phase === 'landed' && state.leap.distance > 2", "label": "lands" },
    { "step": 60 },
    { "input": { "type": "kick" } },
    { "step": 2 },
    { "input": { "type": "debug", "theta": 30, "omega": 0 } },
    { "step": 20 },
    { "assert": "state.swing.omega < 0", "label": "swinging backward" },
    { "input": { "type": "kick" } },
    { "step": 240 },
    { "assert": "state.phase === 'landed' && state.leap.distance >= 0 && state.leap.distance < 1.5 && state.leap.best > 6", "label": "a backward let-go drops behind; the best is kept" },
    { "assert": "(state.sfx.gust ?? 0) === state.gusts", "label": "one gust sound per gust" }
  ]
}
